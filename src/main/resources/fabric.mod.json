{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "${mod_display_url}",
    "sources": "${mod_display_url}",
    "issues": "${mod_issue_tracker_url}"
  },
  "license": "${mod_license}",
  "icon": "xaeronav_icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["net.prason.xaeronav.platform.fabric.FabricEntry"],
    "modmenu": ["net.prason.xaeronav.platform.fabric.XaeroNavModMenu"]
  },
  "mixins": ["xaeronav-xaero.mixins.json"],
  "depends": {
    "fabricloader": "${fabric_loader_range}",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "xaeroworldmap": ">=${xaero_worldmap_version}",
    "xaerominimap": ">=${xaero_minimap_version}"
  }
}
